# Copy to .env (gitignored) — paste Client ID/Secret locally.
# Never commit secrets. Never paste secrets into chat.
#
# Sandbox accounts (GB) — Developer Dashboard:
#   Business (merchant): sb-w0ef453520466@business.example.com  (Default, 1 app)
#   Personal (buyer):    sb-l8kzh53623497@personal.example.com  (Default)
# App credentials: Dashboard → Apps & Credentials → Sandbox → Default Application

# --- required for seed ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- webhook listener (after tunnel URL registered on the app) ---
# Events: BILLING.SUBSCRIPTION.PAYMENT.FAILED
#         BILLING.SUBSCRIPTION.SUSPENDED
#         PAYMENT.SALE.COMPLETED
PAYPAL_WEBHOOK_ID=
WEBHOOK_PUBLIC_URL=

# Optional: reuse an existing catalog product instead of creating one
# PAYPAL_PRODUCT_ID=

# App (when Next.js desk exists)
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=file:./dev.db

# Gemini propose (Step 1) — key in x-goog-api-key header only, never URL
GEMINI_API_KEY=
# Suggested default; live smoke may need a different id
GEMINI_MODEL=gemini-3.1-flash-lite

# Demo fixtures — paste real plan/sub ids after seed / Nov 3 decision
DEMO_MERCHANT_LABEL=sb-w0ef453520466@business.example.com
# Preferred live capture target (I-3HK9STH33F7F SUSPENDED+5.0; I-J8R13K0F76X4 = money-proof history)
SEED_SUBSCRIPTION_ID=I-3HK9STH33F7F
SEED_FAILED_EVENT_ID=
