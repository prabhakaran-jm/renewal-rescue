# Copy to .env (gitignored) — paste Client ID/Secret locally.
# Never commit secrets. Never paste secrets into chat.
#
# Sandbox accounts (GB) — Developer Dashboard:
#   Business (merchant): sb-w0ef453520466@business.example.com  (Default, 1 app)
#   Personal (buyer):    sb-l8kzh53623497@personal.example.com  (Default)
# App credentials: Dashboard → Apps & Credentials → Sandbox → Default Application

# --- required for seed ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- webhook listener (after tunnel URL registered on the app) ---
# Events: BILLING.SUBSCRIPTION.PAYMENT.FAILED
#         BILLING.SUBSCRIPTION.SUSPENDED
#         PAYMENT.SALE.COMPLETED
PAYPAL_WEBHOOK_ID=
WEBHOOK_PUBLIC_URL=

# Optional: reuse an existing catalog product instead of creating one
# PAYPAL_PRODUCT_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=file:./dev.db

# Gemini propose — key in x-goog-api-key header only, never URL
GEMINI_API_KEY=
# Suggested default; live smoke may need a different id
GEMINI_MODEL=gemini-3.1-flash-lite

# Demo fixtures — paste real plan/sub ids after seed
DEMO_MERCHANT_LABEL=sb-w0ef453520466@business.example.com
# Preferred live capture target when still outstanding (confirm with Refresh)
SEED_SUBSCRIPTION_ID=I-S5J71BPHJBT3
# Comma-separated desk IDs (Vercel). Overrides fixtures/seed-ids.json listing when set.
# Include money-proof / cleared history ids so the verified board still probes them.
# Brightline (I-S5J71BPHJBT3) is the preferred remaining spare after Cedar film spend.
SEED_SUBSCRIPTION_IDS=I-3FSFGWWRAV4D,I-CNCX69GD2UD8,I-S5J71BPHJBT3,I-FWR8V1TKDEFW,I-J8R13K0F76X4
# HMAC secret for proposal tokens (required for Propose/Approve on Vercel). Never commit real value.
PROPOSAL_SIGNING_SECRET=
# Required for Approve/Deny (timingSafeEqual). Never commit real value; never log it.
DEMO_PASSCODE=
SEED_FAILED_EVENT_ID=
# Optional: cheaper ACTIVE plan id for revise_cheaper (retention / buyer approve)
# REVISE_CHEAPER_PLAN_ID=
# NOTE: revise has NO PayPal-Request-Id / idempotency. Capture uses token short id as PayPal-Request-Id.
